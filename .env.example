# AWY (Always With You) Environment Variables
# Copy this file to .env or .env.local to configure your environment:
# cp .env.example .env

# Google Gemini API Configuration (Default & Recommended: gemini-flash-lite-latest - cheapest ultra-low cost tier)
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_GEMINI_MODEL=gemini-flash-lite-latest

# Optional: OpenAI API Key (or compatible endpoint)
EXPO_PUBLIC_OPENAI_API_KEY=

# Optional: Backend Server URL for real-time WebSocket / SSE chat
EXPO_PUBLIC_API_URL=http://localhost:3000
